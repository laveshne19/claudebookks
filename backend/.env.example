# ── Nalanda ERP backend environment ──────────────────────────────
# Copy to backend/.env (or set these via docker-compose / your VPS).

# MongoDB connection (required)
MONGO_URL=mongodb://localhost:27017
DB_NAME=nalanda_erp

# Auth (required) — generate a long random string, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Seed super-admin (created on first startup)
ADMIN_EMAIL=admin@nalanda.com
ADMIN_PASSWORD=Admin@123

# ── Optional integrations (app works fully without these) ─────────
# AI customer intelligence — Emergent Universal LLM key.
# If unset, AI features fall back to deterministic insights.
EMERGENT_LLM_KEY=

# Zoho Books sync — leave blank to disable.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_REGION=

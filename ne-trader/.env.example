# NE Kite Autotrader — environment configuration
# Copy to .env and fill in. NEVER commit the real .env.

# --- Kite API (from kite.trade developer console) ---
KITE_API_KEY=your_key_here
KITE_API_SECRET=your_secret_here
KITE_ACCESS_TOKEN=                 # Generated daily, can be empty

# --- Anthropic API (Claude overlay) ---
ANTHROPIC_API_KEY=                 # Leave empty to use rules-only mode
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Trading Config ---
LIVE_MODE=false                    # MUST be 'true' to enable real trades
TOTAL_CAPITAL=100000               # In INR
RISK_PER_TRADE_PCT=2.0
DAILY_LOSS_LIMIT_PCT=5.0
MIN_CONFIDENCE=60.0
MAX_OPEN_POSITIONS=5

# --- Dashboard ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=                # Set a strong one
DASHBOARD_PORT=8000
DASHBOARD_BIND=127.0.0.1           # 127.0.0.1 for SSH-tunnel access only

# --- Scan settings ---
SCAN_INTERVAL_SECONDS=300          # 5 min between scans
INSTRUMENT_REFRESH_HOURS=24        # Refresh instruments CSV daily

# --- Storage (optional overrides) ---
# TRADER_DB_PATH=                  # Defaults to <repo>/ne-trader/data/trader.db
# LOG_DIR=                         # Defaults to <repo>/ne-trader/logs

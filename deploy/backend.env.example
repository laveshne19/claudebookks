# Copy to backend/.env and fill in real values. Do NOT commit the real file.

# --- Database (local MongoDB installed by setup-vps.sh) ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=nalanda

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- AI (Emergent LLM key) ---
EMERGENT_LLM_KEY=

# --- Zoho integration (optional; leave blank to disable sync) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_REGION=

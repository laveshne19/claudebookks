[Unit]
Description=Nalanda ERP FastAPI backend
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__/backend
EnvironmentFile=__REPO_DIR__/backend/.env
ExecStart=__REPO_DIR__/backend/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

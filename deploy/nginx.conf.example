# Nginx site for the Nalanda ERP app.
# Copy to /etc/nginx/sites-available/nalanda, then:
#   ln -s /etc/nginx/sites-available/nalanda /etc/nginx/sites-enabled/
#   rm -f /etc/nginx/sites-enabled/default
#   nginx -t && systemctl reload nginx
#
# Replace YOUR_DOMAIN_OR_IP and __REPO_DIR__ before using.
# For HTTPS, run:  apt-get install -y certbot python3-certbot-nginx && certbot --nginx

server {
    listen 80;
    server_name YOUR_DOMAIN_OR_IP;

    # Frontend static build (React)
    root __REPO_DIR__/frontend/build;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Backend API — adjust the prefix to match your app's API routes.
    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 25m;
}

<header class="site-header glass" data-header role="banner">
  <div class="wrap header__bar">
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo -%}
        <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="160" height="40" style="height:36px;width:auto">
      {%- else -%}{{ shop.name }}{%- endif -%}
    </a>

    <nav class="header__nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <div class="has-mega">
            <a href="{{ link.url }}" aria-haspopup="true">{{ link.title }}</a>
            <div class="mega glass">
              {%- for child in link.links -%}
                <div>
                  <h4>{{ child.title }}</h4>
                  {%- for g in child.links -%}<a href="{{ g.url }}">{{ g.title }}</a>{%- endfor -%}
                  {%- if child.links == blank -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      <div style="position:relative">
        <button class="icon-btn" data-search-toggle aria-label="{{ 'general.search.search' | t }}" onclick="this.nextElementSibling.hidden=!this.nextElementSibling.hidden;this.nextElementSibling.querySelector('input').focus()">🔍</button>
        <div class="search-pop glass" hidden style="position:absolute;right:0;top:52px;width:min(420px,90vw);padding:12px;border-radius:var(--radius);z-index:95">
          <input data-search-input type="search" placeholder="{{ 'general.search.placeholder' | t }}" style="width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;font-size:1rem" aria-label="{{ 'general.search.search' | t }}">
          <div data-search-results hidden style="margin-top:8px;display:grid;gap:4px"></div>
        </div>
      </div>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">👤</a>
      <button class="icon-btn" data-open-cart aria-label="{{ 'general.cart.title' | t }}" style="position:relative">
        🛍️<span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<style>
  .search__item{display:flex;align-items:center;gap:10px;padding:8px;border-radius:10px;font-size:.9rem;font-weight:600}
  .search__item:hover{background:var(--surface)} .search__item img{border-radius:8px;object-fit:cover}
  .search__empty{padding:12px;color:var(--ink-40);font-size:.9rem}
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}

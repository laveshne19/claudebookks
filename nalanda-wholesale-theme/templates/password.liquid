<section>
  <p class="eyebrow">Coming soon</p>
  <h1 class="display" style="font-size:var(--fs-h1)"><span class="grad" style="background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent">{{ shop.name }}</span></h1>
  <p class="muted">{{ shop.password_message | default: 'Something premium is on the way.' }}</p>
  {% form 'storefront_password' %}
    {%- if form.errors -%}<p style="color:#c0392b">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div style="display:flex;gap:8px;justify-content:center;margin-top:16px;flex-wrap:wrap">
      <input type="password" name="password" placeholder="Enter store password" style="padding:14px;border:1px solid var(--line);border-radius:12px" aria-label="Store password">
      <button class="btn btn--accent" type="submit">Enter</button>
    </div>
  {% endform %}
</section>

<section class="section">
  <div class="wrap" style="max-width:900px">
    <h1 class="h2">{{ 'general.cart.title' | t }}</h1>
    {%- if cart.item_count == 0 -%}
      <p class="muted">{{ 'general.cart.empty' | t }}</p>
      <a class="btn btn--accent" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" data-no-ajax>
        {%- for item in cart.items -%}
          <div style="display:flex;gap:16px;padding:18px 0;border-bottom:1px solid var(--line);align-items:center">
            {%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" style="border-radius:12px;object-fit:cover">{%- endif -%}
            <div style="flex:1"><a href="{{ item.url }}" style="font-weight:700">{{ item.product.title }}</a><div class="muted" style="font-size:.85rem">{{ item.variant.title }}</div></div>
            <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" style="width:64px;padding:10px;border:1px solid var(--line);border-radius:10px">
            <strong>{{ item.final_line_price | money }}</strong>
          </div>
        {%- endfor -%}
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:24px">
          <div style="font-size:1.3rem;font-weight:800">{{ 'general.cart.subtotal' | t }}: {{ cart.total_price | money }}</div>
          <div style="display:flex;gap:10px">
            <button class="btn btn--ghost" type="submit" name="update">Update</button>
            <button class="btn btn--accent" type="submit" name="checkout">{{ 'general.cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

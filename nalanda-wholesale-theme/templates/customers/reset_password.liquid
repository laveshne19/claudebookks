<section class="section"><div class="wrap" style="max-width:440px">
  <h1 class="h2">Reset password</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" required placeholder="New password" style="width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;margin:6px 0">
    <input type="password" name="customer[password_confirmation]" required placeholder="Confirm password" style="width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;margin:6px 0 14px">
    <button class="btn btn--accent btn--block" type="submit">Reset</button>
  {% endform %}
</div></section>

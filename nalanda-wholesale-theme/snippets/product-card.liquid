{%- comment -%} Wholesale product card: MOQ badge + per-unit price + bulk add {%- endcomment -%}
{%- assign p = product -%}
{%- assign moq = p.metafields.custom.moq.value | default: settings.default_moq | default: 1 -%}
{%- assign on_sale = false -%}{%- if p.compare_at_price > p.price -%}{%- assign on_sale = true -%}{%- endif -%}

<article class="card card--trade" data-reveal>
  <a href="{{ p.url }}" class="card__media" aria-label="{{ p.title | escape }}">
    <span class="card__badge card__badge--moq">MOQ {{ moq }}</span>
    {%- if p.featured_image -%}
      <img src="{{ p.featured_image | image_url: width: 600 }}"
           srcset="{{ p.featured_image | image_url: width: 300 }} 300w, {{ p.featured_image | image_url: width: 600 }} 600w"
           sizes="(max-width:749px) 45vw, 20vw"
           alt="{{ p.featured_image.alt | default: p.title | escape }}" width="600" height="600" loading="lazy">
    {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'card__media' }}{%- endif -%}
  </a>
  <div class="card__body">
    {%- if p.vendor != blank -%}<div class="card__brand">{{ p.vendor }}</div>{%- endif -%}
    <h3 class="card__title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
    <div class="card__price">
      {{ p.price | money }}{%- if settings.show_per_unit -%}<span class="per-unit">/unit</span>{%- endif -%}
      {%- if on_sale -%}<del>{{ p.compare_at_price | money }}</del>{%- endif -%}
    </div>
    {%- assign tiers = p.metafields.custom.tier_prices.value -%}
    {%- if tiers -%}<div class="card__tier">Bulk price from {{ tiers.last | split: '|' | last }}/unit</div>{%- endif -%}
    <div class="card__quick">
      {%- if p.available -%}
        <form method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="{{ moq }}">
          <button type="submit" class="btn btn--accent btn--block">Add {{ moq }} to order</button>
        </form>
      {%- else -%}<a class="btn btn--ghost btn--block" href="{{ p.url }}">Enquire</a>{%- endif -%}
    </div>
  </div>
</article>

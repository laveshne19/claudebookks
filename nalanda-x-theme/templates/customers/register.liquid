<section class="section"><div class="wrap" style="max-width:440px">
  <h1 class="h2">Create account</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <input type="text" name="customer[first_name]" placeholder="First name" style="width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;margin:6px 0">
    <input type="text" name="customer[last_name]" placeholder="Last name" style="width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;margin:6px 0">
    <input type="email" name="customer[email]" required placeholder="Email" style="width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;margin:6px 0">
    <input type="password" name="customer[password]" required placeholder="Password" style="width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;margin:6px 0 14px">
    <button class="btn btn--accent btn--block" type="submit">Create</button>
  {% endform %}
  <p style="margin-top:14px"><a href="{{ routes.account_login_url }}">Already have an account? Login</a></p>
</div></section>

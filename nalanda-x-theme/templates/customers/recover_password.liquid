<section class="section"><div class="wrap" style="max-width:440px">
  <h1 class="h2">Recover password</h1>
  {% form 'recover_customer_password' %}
    {{ form.errors | default_errors }}
    {%- if form.posted_successfully? -%}<p class="muted">We’ve sent you a reset email.</p>{%- endif -%}
    <input type="email" name="email" required placeholder="Email" style="width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;margin:6px 0 14px">
    <button class="btn btn--accent btn--block" type="submit">Send reset link</button>
  {% endform %}
  <p style="margin-top:14px"><a href="{{ routes.account_login_url }}">Back to login</a></p>
</div></section>

<section class="section"><div class="wrap">
  <header data-reveal style="margin-bottom:var(--gap)"><p class="eyebrow">Tech Insights</p><h1 class="h2">{{ blog.title }}</h1></header>
  <div class="grid grid--3" data-reveal-stagger>
    {%- for article in blog.articles -%}
      <a class="card" href="{{ article.url }}">
        <div class="card__media">{%- if article.image -%}<img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" width="700" height="700" loading="lazy">{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
        <div class="card__body"><span class="card__brand">{{ article.published_at | date: '%b %d, %Y' }}</span><h3 class="card__title">{{ article.title }}</h3><p class="muted" style="font-size:.85rem">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p></div>
      </a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}{ "name": "Blog", "settings": [] }{% endschema %}

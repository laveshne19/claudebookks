<div class="drawer" data-cart-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'general.cart.title' | t }}">
  <div class="drawer__scrim" data-close-cart></div>
  <aside class="drawer__panel">
    <div class="drawer__head">
      <strong>{{ 'general.cart.title' | t }}</strong>
      <button class="icon-btn" data-close-cart aria-label="{{ 'general.accessibility.close' | t }}">✕</button>
    </div>
    <div class="drawer__items" data-cart-items>
      {%- if cart.item_count == 0 -%}
        <p class="muted">{{ 'general.cart.empty' | t }}</p>
      {%- else -%}
        {%- for item in cart.items -%}
          <div style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)">
            {%- if item.image -%}<img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" width="60" height="60" style="border-radius:10px;object-fit:cover">{%- endif -%}
            <div style="flex:1">
              <div style="font-weight:600;font-size:.9rem">{{ item.product.title }}</div>
              <div class="muted" style="font-size:.82rem">{{ item.variant.title }}</div>
              <div style="font-weight:700;margin-top:4px">{{ item.final_line_price | money }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="drawer__foot">
      <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-weight:800">
        <span>{{ 'general.cart.subtotal' | t }}</span><span data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>
      <a href="{{ routes.cart_url }}" class="btn btn--ghost btn--block" style="margin-bottom:8px">{{ 'general.cart.view' | t }}</a>
      <a href="{{ routes.cart_url }}/checkout" class="btn btn--accent btn--block">{{ 'general.cart.checkout' | t }}</a>
    </div>
  </aside>
</div>

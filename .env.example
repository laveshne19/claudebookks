# ── Nalanda ERP — deployment environment (docker compose) ─────────
# Copy to .env, then fill in. Never commit the real .env.

# Public HTTP port on the VPS (use 80, or e.g. 8080 if behind another proxy).
HTTP_PORT=80

# Database name.
DB_NAME=nalanda_erp

# REQUIRED — long random secret for signing JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Seed super-admin (created on first boot). CHANGE THE PASSWORD.
ADMIN_EMAIL=admin@nalanda.com
ADMIN_PASSWORD=Admin@123

# Frontend → backend URL. Leave EMPTY for the standard single-domain setup
# (nginx proxies /api to the backend). Set a full URL only for split domains.
REACT_APP_BACKEND_URL=

# ── Optional (app runs fully without these) ───────────────────────
# Emergent Universal LLM key — enables live AI insights; blank = fallbacks.
EMERGENT_LLM_KEY=

# Zoho Books sync — leave blank to disable.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_REGION=
